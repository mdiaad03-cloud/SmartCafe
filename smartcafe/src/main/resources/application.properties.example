spring.application.name=smartcafe
spring.datasource.url=jdbc:sqlserver://localhost:1433;databaseName=smartcafe;encrypt=true;trustServerCertificate=true
spring.datasource.username=YOUR_DB_USERNAME
spring.datasource.password=YOUR_DB_PASSWORD
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true
